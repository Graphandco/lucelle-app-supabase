   "scripts": {
      "dev": "next dev --turbopack",
      "build": "next build",
      "start": "next start",
      "lint": "next lint",
      "dev:docker": "concurrently -k \"PORT=3001 node --watch server.js\" \"npx wait-on -t 10000 http://localhost:3001 && npx browser-sync start -c bs-config.docker.js\"",
      "docker:build": "docker compose -f docker-compose.yml build",
